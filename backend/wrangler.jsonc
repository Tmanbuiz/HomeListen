{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homelisten",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "homelisten.oralyvo.app", "custom_domain": true }],
  "assets": {
    "directory": "../viewer/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "FIREBASE_PROJECT_ID": "home-listen",
    "FIREBASE_API_KEY": "AIzaSyDAghHVhjEegmq0YYD3cv9rzqkROPk-lo0",
    "FIREBASE_WEB_APP_ID": "1:551000593925:web:5e5fb58471e935854e2e6c",
    "FIREBASE_ANDROID_APP_ID": "1:551000593925:android:512ba5a387520b9c4e2e6c",
    "FIREBASE_IOS_APP_ID": "",
    "FIREBASE_MESSAGING_SENDER_ID": "551000593925",
    "VAPID_PUBLIC_KEY": "BMNHcsPZ07q2dj5lHSoIy0azYWbNeoypBEcxo1fhObuG13LQGMO51cKGMsiGf_IZaA_159Fpr3wInZbc-KwKllA",
    "VAPID_SUBJECT": "https://github.com/Tmanbuiz/HomeListen",
    "PUBLIC_ORIGIN": "https://homelisten.oralyvo.app",
    "ALLOW_TURN": "false",
  }
}
